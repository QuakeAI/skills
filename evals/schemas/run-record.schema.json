{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["case_id", "run", "passed", "assertions", "output_file"],
  "properties": {
    "case_id": {"type": "string"},
    "run": {"type": "integer", "minimum": 1},
    "passed": {"type": "boolean"},
    "assertions": {"type": "array"},
    "output_file": {"type": "string"}
  }
}
