{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "skill", "expected_operation_ids", "prompt", "must", "must_not"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "skill": {"type": "string"},
    "expected_operation_ids": {"type": "array", "items": {"type": "string"}},
    "expected_language": {"type": "string", "enum": ["curl", "python", "typescript"]},
    "prompt": {"type": "string", "minLength": 1},
    "must": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "must_not": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
