{
  "id": "example.lookup-record",
  "name": "Lookup record",
  "description": "Public synthetic fixture for tests.",
  "input_schema": [
    {
      "location": "path",
      "schema": {
        "type": "object",
        "properties": {
          "recordId": {
            "type": "string",
            "description": "Record identifier",
            "minLength": 1
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "base64": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "oneOf": [
                {
                  "required": [
                    "base64"
                  ]
                },
                {
                  "required": [
                    "url"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "recordId"
        ]
      }
    },
    {
      "location": "query",
      "arrayFormat": "repeat",
      "schema": {
        "type": "object",
        "properties": {
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "summary",
                "history"
              ]
            }
          },
          "locale": {
            "type": [
              "string",
              "null"
            ],
            "default": "en"
          },
          "legacyNullable": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
